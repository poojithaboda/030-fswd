<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSE-B V Semester Timetable</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f1f3f6;
            color: #222;
            padding: 25px;
        }

        .container {
            max-width: 1250px;
            margin: auto;
            background: #fff;
            border: 1px solid #bbb;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
        }

        .header {
            text-align: center;
            padding: 18px 10px 12px;
            border-bottom: 2px solid #333;
        }

        .college {
            font-size: 22px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .department {
            font-size: 14px;
            font-weight: bold;
            margin-top: 6px;
        }

        .address {
            font-size: 11px;
            margin-top: 3px;
        }

        .title {
            font-size: 16px;
            font-weight: bold;
            margin-top: 10px;
        }

        .details {
            display: flex;
            justify-content: space-between;
            padding: 10px 18px;
            font-size: 13px;
            font-weight: bold;
            border-bottom: 1px solid #555;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1000px;
        }

        th,
        td {
            border: 1px solid #555;
            text-align: center;
            padding: 12px 7px;
        }

        th {
            background: #e9ecef;
            font-size: 12px;
            font-weight: bold;
        }

        td {
            font-size: 12px;
            height: 62px;
        }

        .day {
            background: #f0f0f0;
            font-weight: bold;
            width: 70px;
        }

        .subject {
            font-weight: bold;
        }

        .lab {
            background: #e8f4ff;
            font-weight: bold;
        }

        .lecture {
            background: #fff;
        }

        .elective {
            background: #fff4d6;
            font-weight: bold;
        }

        .lunch {
            background: #f5f5f5;
            font-weight: bold;
            writing-mode: vertical-rl;
            transform: rotate(180deg);
            letter-spacing: 2px;
            width: 45px;
        }

        .footer {
            padding: 12px 18px;
            border-top: 2px solid #333;
            font-size: 12px;
            font-weight: bold;
        }

        .legend {
            display: flex;
            gap: 20px;
            justify-content: center;
            padding: 15px;
            background: #fafafa;
            border-top: 1px solid #ccc;
        }

        .legend span {
            font-size: 12px;
            font-weight: bold;
            padding: 7px 12px;
            border: 1px solid #bbb;
        }

        .legend .lab-box {
            background: #e8f4ff;
        }

        .legend .elective-box {
            background: #fff4d6;
        }

        @media (max-width: 700px) {
            body {
                padding: 10px;
            }

            .college {
                font-size: 16px;
            }

            .department {
                font-size: 11px;
            }

            .title {
                font-size: 13px;
            }

            .details {
                font-size: 11px;
                flex-direction: column;
                gap: 5px;
                text-align: center;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="header">
            <div class="college">VASAVI COLLEGE OF ENGINEERING (AUTONOMOUS)</div>
            <div class="address">Ibrahim Bagh, Hyderabad - 500031</div>
            <div class="department">DEPARTMENT OF COMPUTER SCIENCE AND ENGINEERING</div>
            <div class="title">TIME TABLE</div>
        </div>

        <div class="details">
            <span>YEAR: 2026-27</span>
            <span>CLASS: B.E. V SEMESTER (CSE-A)</span>
            <span>ROOM NO: R-301</span>
            <span>W.E.F. 03.08.2026</span>
        </div>

        <div class="table-wrapper">

            <table>

                <thead>
                    <tr>
                        <th>DAY / TIME</th>
                        <th>9:20 AM<br>TO<br>10:40 AM</th>
                        <th>10:40 AM<br>TO<br>11:40 AM</th>
                        <th>11:40 AM<br>TO<br>12:40 PM</th>
                        <th>12:40 PM<br>TO<br>2:20 PM</th>
                        <th>2:20 PM<br>TO<br>3:20 PM</th>
                        <th>3:20 PM<br>TO<br>4:20 PM</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td class="day">MON</td>
                        <td class="lab">IoT Lab<br>(Lab-IV)</td>
                        <td class="lecture">Mentor / FSWD</td>
                        <td class="lecture"></td>
                        <td class="lunch" rowspan="6">LUNCH</td>
                        <td class="elective">OE</td>
                        <td class="subject">IoT</td>
                        <td class="subject">CN</td>
                    </tr>

                    <tr>
                        <td class="day">TUE</td>
                        <td class="subject">AI</td>
                        <td class="lecture" colspan="2">SDC-VI (CS-II)</td>
                        <td class="elective">OE</td>
                        <td class="subject">CN</td>
                        <td class="lecture">Security / FSWD</td>
                    </tr>

                    <tr>
                        <td class="day">WED</td>
                        <td class="subject">DT</td>
                        <td class="subject">AI</td>
                        <td class="subject">IoT</td>
                        <td class="elective">OE</td>
                        <td class="lab">AIML Lab<br>(Lab-VI)</td>
                    </tr>

                    <tr>
                        <td class="day">THU</td>
                        <td class="subject">CN</td>
                        <td class="lab" colspan="2">CN Lab<br>(Project Lab)</td>
                        <td class="lecture" colspan="2">SDC-VI (TS-III)</td>
                        <td class="subject">DT</td>
                    </tr>

                    <tr>
                        <td class="day">FRI</td>
                        <td class="subject">IoT</td>
                        <td class="subject">AI</td>
                        <td class="subject">CN (T)</td>
                        <td class="lecture">FSWD</td>
                        <td class="lab" colspan="2">FSWD Lab<br>(Project Lab)</td>
                    </tr>

                    <tr>
                        <td class="day">SAT</td>
                        <td class="subject">FSWD</td>
                        <td class="lab" colspan="2">TBP-1 / CISCO<br>(Lab-V)</td>
                        <td class="lecture">ECA-II</td>
                        <td class="subject">IoT</td>
                    </tr>

                </tbody>

            </table>

        </div>

        <div class="legend">
            <span class="lab-box">LAB / PRACTICAL</span>
            <span class="elective-box">OPEN ELECTIVE</span>
            <span>LECTURE</span>
        </div>

        <div class="footer">
            Extra-Curricular Activity-II / Sports / Library
        </div>

    </div>

</body>
</html>
